# Solo configuración pública: todo lo que lleva prefijo VITE_ termina en el bundle. Nunca secretos.

# Gateway del backend real (único punto de entrada REST).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Mocks MSW (solo en desarrollo) para operaciones marcadas x-status: planned en el contrato.
#   planned -> mockea únicamente lo planificado; lo implementado va al backend real (por defecto)
#   off     -> sin mocks
VITE_MOCKS=planned
